{
  "name": "agentfarm",
  "version": "1.0.0",
  "description": "Lightweight AI workflow orchestrator for software development",
  "type": "module",
  "bin": {
    "agentfarm": "./bin/agentfarm"
  },
  "files": [
    "dist/",
    "bin/",
    "workflows/",
    "prompts/",
    "agents/",
    "templates/"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "execa": "^8.0.0",
    "yargs": "^17.7.0",
    "prompts": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/yargs": "^17.0.0",
    "@types/prompts": "^2.4.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["ai", "workflow", "automation", "claude", "agents"],
  "license": "MIT"
}
